# Application
NODE_ENV=development
PORT=3000

# AI Provider
AI_PROVIDER=ollama

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_FALLBACK_CHAT_MODEL=gemma3:4b
EMBEDDING_DIMENSION=768

# Database URL with schema as query parameter
DATABASE_URL="postgresql://user:password@127.0.0.1:5434/backend_db?schema=public"

# Test database
TEST_DATABASE_URL="postgresql://user:password@127.0.0.1:5434/backend_db?schema=test"

# Database pool size
DATABASE_POOL_SIZE=5
